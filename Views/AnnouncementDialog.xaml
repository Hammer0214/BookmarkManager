<Window x:Class="BookmarkManager.Views.AnnouncementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="公告" Height="400" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None"
        Icon="pack://application:,,,/app.ico"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0" Background="{DynamicResource HeaderBackground}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="  📢 公告" FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <Button Grid.Column="1" x:Name="CloseBtn" Content="✕" Click="CloseBtn_Click"
                    Width="46" Height="32" FontSize="14"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Cursor="Hand" Focusable="True">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource DangerBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D32F2F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,16">
            <RichTextBox x:Name="AnnouncementContent"
                         IsReadOnly="True" BorderThickness="0"
                         Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="13">
                <RichTextBox.Document>
                    <FlowDocument LineStackingStrategy="BlockLineHeight" PagePadding="0">
                        <Paragraph>
                            <Run Text="欢迎使用 标签页收藏管理器 V0.0.1" FontWeight="Bold" FontSize="16"/>
                        </Paragraph>
                        <Paragraph Margin="0,12,0,0">
                            <Run Text="这是一个轻量级的书签管理工具，支持分类、标签、搜索、导入导出等功能。"/>
                        </Paragraph>
                        <Paragraph Margin="0,8,0,0">
                            <Run Text="主要特性：" FontWeight="SemiBold"/>
                        </Paragraph>
                        <Paragraph Margin="12,4,0,0">
                            <Run Text="• 分类管理：创建、编辑、删除分类，支持自定义图标"/>
                        </Paragraph>
                        <Paragraph Margin="12,2,0,0">
                            <Run Text="• 书签管理：添加、编辑、删除、一键打开、拖拽排序"/>
                        </Paragraph>
                        <Paragraph Margin="12,2,0,0">
                            <Run Text="• 标签系统：创建、删除标签，关联书签，按标签筛选"/>
                        </Paragraph>
                        <Paragraph Margin="12,2,0,0">
                            <Run Text="• 搜索功能：按标题、URL、描述搜索"/>
                        </Paragraph>
                        <Paragraph Margin="12,2,0,0">
                            <Run Text="• 导入/导出：JSON 和 HTML 书签格式"/>
                        </Paragraph>
                        <Paragraph Margin="12,2,0,0">
                            <Run Text="• 深色/浅色主题切换"/>
                        </Paragraph>
                        <Paragraph Margin="12,2,0,0">
                            <Run Text="• 键盘快捷键支持"/>
                        </Paragraph>
                        <Paragraph Margin="0,12,0,0">
                            <Run Text="感谢您的使用！" Foreground="{DynamicResource PrimaryBrush}"/>
                        </Paragraph>
                    </FlowDocument>
                </RichTextBox.Document>
            </RichTextBox>
        </ScrollViewer>

        <!-- Buttons -->
        <Border Grid.Row="2" Padding="20,12" Background="{DynamicResource StatusBarBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="不再显示" Click="DontShowAgain_Click" Padding="16,8" FontSize="13"
                        Background="Transparent" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand"
                        Margin="0,0,8,0" ToolTip="下次启动不再显示此公告"/>
                <Button Content="关闭" Click="Close_Click" Padding="20,8" FontSize="13"
                        Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0"
                        Cursor="Hand" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
