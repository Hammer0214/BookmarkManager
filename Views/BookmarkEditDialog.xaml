<Window x:Class="BookmarkManager.Views.BookmarkEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑书签" Height="490" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None"
        Icon="pack://application:,,,/app.ico"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid Grid.Row="0" Background="{DynamicResource HeaderBackground}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="  编辑书签" FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <Button Grid.Column="1" x:Name="CloseBtn" Content="✕" Click="CloseBtn_Click"
                    Width="46" Height="32" FontSize="14"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Cursor="Hand" Focusable="True">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource DangerBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D32F2F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="网址 *" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBox Grid.Row="1" x:Name="UrlBox" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="13" Padding="8,6" Margin="0,0,0,12"
                     Background="{DynamicResource SearchBoxBackground}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>

            <TextBlock Grid.Row="2" Text="标题" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBox Grid.Row="3" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="13" Padding="8,6" Margin="0,0,0,12"
                     Background="{DynamicResource SearchBoxBackground}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>

            <TextBlock Grid.Row="4" Text="分类" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <ComboBox Grid.Row="5" ItemsSource="{Binding AllCategories}"
                      SelectedValue="{Binding CategoryId}"
                      SelectedValuePath="Id" DisplayMemberPath="Name"
                      FontSize="13" Padding="8,6" Margin="0,0,0,8"
                      Background="{DynamicResource SearchBoxBackground}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"/>

            <TextBlock Grid.Row="6" Text="备注" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,4"/>
            <TextBox Grid.Row="7" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="13" Padding="8,6" Margin="0,0,0,8"
                     AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="60"
                     Background="{DynamicResource SearchBoxBackground}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>

            <TextBlock Grid.Row="8" Text="标签" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,4"/>
            <ScrollViewer Grid.Row="9" VerticalScrollBarVisibility="Auto" MaxHeight="60" Margin="0,0,0,12">
                <ItemsControl ItemsSource="{Binding AllTags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,4" CornerRadius="12" Margin="2,2" Cursor="Hand"
                                    Background="{DynamicResource TagBrush}"
                                    MouseLeftButtonDown="Tag_Toggle" Tag="{Binding}">
                                <TextBlock Text="{Binding Name}" FontSize="12"
                                           Foreground="{DynamicResource TagTextBrush}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确定" Click="Ok_Click" Padding="20,8" FontSize="13"
                        Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Margin="0,0,8,0"/>
                <Button Content="取消" Click="Cancel_Click" Padding="20,8" FontSize="13"
                        Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Foreground="{DynamicResource TextPrimaryBrush}" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
